# TunICA configuration.
#
# This file ships with TunICA and is read from beside tunica.sh. Everything is commented
# out, so out of the box every value falls back to its built-in default. Uncomment what
# you want to change; the installer fills in your onboarding answers here.
#
# Precedence, highest first:
#   1. command-line flag        (-d, -m, -o)
#   2. shell environment        (export TUNICA_MODEL=opus)
#   3. this file
#   4. built-in default

# --- where things go ----------------------------------------------------------------
# Root for generated maps; each run writes <root>/<repo-name>/.  Default: <install dir>/out
#TUNICA_OUT_ROOT="$HOME/TunICA/out"

# Operations log.                                   Default: <install dir>/tunica.log
#TUNICA_LOG_FILE="$HOME/TunICA/tunica.log"

# Days of log history to keep; 0 disables pruning.  Default: 14
#TUNICA_LOG_MAX_DAYS="14"

# --- model ---------------------------------------------------------------------------
# Passed to `claude --model`. Any alias your CLI accepts: sonnet, opus, haiku, or a full id.
#TUNICA_MODEL="sonnet"

# Claude CLI binary. Auto-detected on PATH, then ~/.local/bin/claude.
#TUNICA_CLAUDE_BIN="$HOME/.local/bin/claude"

# Seconds allowed per claude call before it is killed.  Default: 600
#TUNICA_TIMEOUT="600"

# --- mapping -------------------------------------------------------------------------
# Default depth: 1 = system map only, 2 = + one map per component.  Default: 2
#TUNICA_DEPTH="2"

# Refuse repositories larger than this many files.  Default: 4000
#TUNICA_MAX_FILES="4000"

# Bytes of a single file sent to the model.         Default: 60000
#TUNICA_MAX_FILE_BYTES="60000"

# Bytes of all files of one component combined.     Default: 120000
#TUNICA_MAX_COMPONENT_BYTES="120000"

# --- viewer --------------------------------------------------------------------------
# Port used by `tunica view`. 8864 is TUNI on a phone keypad; TUNICA itself is 886422,
# which is past the 65535 ceiling.                  Default: 8864
TUNICA_VIEW_PORT="8865"

# Which interface the viewer listens on.            Default: auto
#   auto        every interface when the shell is an SSH session, loopback otherwise
#               (a systemd service has no SSH session, so auto means loopback there)
#   0.0.0.0     always reachable from the network (anyone who can reach the host can read the maps)
#   127.0.0.1   always local only; reach it from elsewhere with an SSH tunnel
#   <address>   a specific address, when the host sits on several segments
#TUNICA_VIEW_BIND="auto"

# Let the viewer page manage maps: start a run, and remove a stored map. Off by
# default, because a run spends your model tokens and clones what it is given, and a
# removal is permanent. Who can reach the port is your network's business, not this
# tool's.                                            Default: false
#TUNICA_VIEW_ALLOW_GENERATE="false"

# Public address to print instead of a raw host:port, for hosts behind a reverse proxy.
# The viewer still listens on TUNICA_VIEW_BIND; this only changes the link you are given.
TUNICA_VIEW_URL="https://homelab.assarelius.org/tunica-dev"

# --- staying up across a logout or a reboot ------------------------------------------
# There is no setting here, and nothing is installed by default: `tunica view` is a
# foreground server that ends with the terminal that started it, and a reboot ends it too.
# If you want it to survive both, ask for it once:
#
#   tunica service install        write and enable a systemd --user unit
#   tunica service status         what is installed, if anything
#   tunica service remove         take it back out
#
# No sudo and no system unit: the unit lands in ~/.config/systemd/user/. To keep it
# running after you log out of a headless host, systemd also needs lingering enabled,
# which is one command it will print for you: loginctl enable-linger <you>.
